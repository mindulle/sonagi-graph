# CLIProxyAPI를 사용하기 위한 OpenAI 호환 환경 변수
OPENAI_API_KEY=dummy
OPENAI_API_BASE=http://172.19.0.1:38107/v1  # Docker 브릿지 통과용 (실제 서버 환경에 맞게 조정)

# LangSmith Studio UI 연동용 키 (옵션)
LANGSMITH_API_KEY=your_langsmith_api_key_here

# 그래프별 LLM 모델 (미지정 시 gemini-3-flash)
EDITORIAL_LLM_MODEL=gemini-3-flash
VISUAL_LLM_MODEL=gemini-3-flash
COPYWRITING_LLM_MODEL=gemini-3-flash
LOGO_CONCEPT_LLM_MODEL=gemini-3-flash
LOGO_VISION_LLM_MODEL=gemini-3-flash
LOGO_REFINE_LLM_MODEL=gemini-3-flash
LOGO_RESEARCH_LLM_MODEL=gemini-3-flash
LOGO_VISION_LLM_MODEL=gemini-3-flash
ERROR_TRIAGE_LLM_MODEL=gemini-3-flash

# 볼트 루트 — 검증 리포트·지식 카탈로그 저장 위치
SONAGI_WIKI_DIR=/home/ubuntu/llm-wiki

# video_ops 산출물
SONAGI_VIDEO_OUT=/tmp/video_ops
SONAGI_CDN_VIDEO_DIR=/var/www/craft-suite/video/exports
SONAGI_PRESS_DIR=/home/ubuntu/sonagi-work
SONAGI_VIDEO_PUBLIC_BASE=https://draw.sonagi.space/video/exports

# source_verification — 로컬 SearXNG (search 엔드포인트가 JSON을 내려야 한다)
SEARXNG_URL=http://localhost:8080
