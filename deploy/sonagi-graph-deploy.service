[Unit]
Description=sonagi-graph pull deploy (GHCR stable)
Documentation=file:///home/ubuntu/sonagi-graph/docs/DEPLOY_GHCR.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/sonagi-graph
# langgraph CLI는 ~/.local/bin에 있다. systemd 기본 PATH에는 없으므로 명시한다.
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/sonagi-graph/deploy/sonagi-graph-deploy.sh
TimeoutStartSec=900
Nice=10
SyslogIdentifier=sonagi-graph-deploy
