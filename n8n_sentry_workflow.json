{
  "name": "[Sonagi-Workflows] Sentry to LangGraph Triage",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sentry-to-langgraph",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Sentry Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://10.0.0.193:8123/threads",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "name": "Create Thread",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://10.0.0.193:8123/threads/' + $json.thread_id + '/runs' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"assistant_id\": \"error_triage\",\n  \"input\": {\n    \"messages\": [\n      {\n        \"role\": \"user\",\n        \"content\": \"{{ $node['Sentry Webhook'].json.body.message || $node['Sentry Webhook'].json.body.error || 'Unknown Error' }}\"\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "name": "Trigger Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Sentry Webhook": {
      "main": [
        [
          {
            "node": "Create Thread",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Thread": {
      "main": [
        [
          {
            "node": "Trigger Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}